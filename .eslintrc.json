{
    "extends": ["airbnb", "prettier", "prettier/react"],
    "rules": {
        "no-console": 0,
        "max-len": 0,
        "camelcase": 0,
        "no-underscore-dangle": 0,
        "import/prefer-default-export": 0,
        "indent": ["error", 4, {
            "SwitchCase": 1
        }],
        "react/jsx-filename-extension": 0,
        "react/jsx-indent": ["error", 4],
        "react/jsx-indent-props": ["error", 4],
        "react/no-did-mount-set-state": 1,
        "react/no-danger": 0,
        "jsx-a11y/no-static-element-interactions": 0,
        "jsx-a11y/click-events-have-key-events": 0,
        "import/no-unresolved": [ "error", { "ignore": [ "theme", "env", "vars" ] } ],
        "object-curly-newline": 0,
        "react/jsx-props-no-spreading": 0,
        "prettier/prettier": ["error"],
        "consistent-return": 0
    },
    "env": {
      "es6": true,
      "browser": true,
      "node": true,
      "jest/globals": true
    },
    "parser": "babel-eslint",
    "globals": {
        "gapi": true,
        "os": true,
        "google": true,
        "module": true,
        "react": true,
        "console": true,
        "require": true,
        "test": true,
        "describe": true,
        "jest": true,
        "beforeEach": true,
        "beforeAll": true,
        "afterAll": true,
        "afterEach": true,
        "expect": true
    },
    "plugins": [
        "react",
        "jsx-a11y",
        "import",
        "jest",
        "react-hooks",
        "prettier"
    ]
}

{
    extends: "airbnb",
    rules: {
        "no-console": 0,
        "max-len": 0,
        "comma-dangle": 0,
        "no-underscore-dangle": 0,
        "import/prefer-default-export": 0,
        "indent": ["error", 4, {
            "SwitchCase": 1
        }],
        "react/jsx-filename-extension": 0,
        "react/jsx-indent": ["error", 4],
        "react/jsx-indent-props": ["error", 4],
        "react/no-did-mount-set-state": 1,
        "react/no-danger": 0,
        "jsx-a11y/no-static-element-interactions": 0,
        "react/jsx-one-expression-per-line": 0
    },
    "env": {
      "es6": true,
      "browser": true,
      "node": true,
      "mocha": true
    },
    "parser": "babel-eslint",
    "globals": {
        "google": true,
        "module": true,
        "react": true,
        "console": true,
        "require": true
    },
    plugins: [
        "react",
        "jsx-a11y",
        "import"
    ]
}

{
  "name": "springCreek",
  "version": "1.0.0",
  "description": "Ward program and announcement manager",
  "scripts": {
    "start": "NODE_ENV=development DB_ENV=test run-p start:local make:EnvConfig",
    "start:local": "node -r @babel/register server",
    "build": "run-s make:EnvConfig build:client",
    "build:client": "webpack -p -r @babel/register",
    "build:func": "yarn babel src/functions -d functions",
    "deploy": "yarn build && yarn firebase deploy --only hosting:test",
    "deploy:prod": "yarn build && yarn firebase deploy --only hosting:production",
    "deploy:func": "yarn build:func && cd functions && yarn deploy",
    "theme": "gulp build-css build-assets --gulpfile ./semantic/gulpfile.js",
    "make:EnvConfig": "node -r @babel/register src/server/utils/makeEnvironmentConfig.js",
    "make:files": "node -r @babel/register src/server/scripts/buildFiles.js",
    "make:program": "DB_ENV=production node -r @babel/register src/server/scripts/program.js",
    "att": "DB_ENV=test node -r @babel/register src/server/scripts/addAttendance.js"
  },
  "author": "Ben Ellis <benellislds@gmail.com>",
  "license": "ISC",
  "devDependencies": {

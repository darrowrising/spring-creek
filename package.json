{
  "name": "spring-creek",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --open --port=3010",
    "dev:prod": "bun dev --mode production",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "vitest",
    "test:run": "vitest run",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "vite",
    "make:program": "bun src/scripts/makeProgram.js",
    "move:events": "bun src/scripts/moveEvents.js",
    "script": "bin/run-script.sh",
    "deploy": "bun run build --mode development && firebase deploy --only hosting:test",
    "deploy:prod": "bun run build && firebase deploy --only hosting:production",
    "deploy:functions": "firebase deploy --only functions --project springcreek-test",
    "emulate:functions": "firebase emulators:start --only functions --project springcreek-test"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.2.1",
    "dayjs": "^1.11.10",
    "firebase": "^8",
    "polished": "^4.2.2",
    "prop-types": "^15.8.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-ga": "^3.3.1",
    "react-router-dom": "^6.18.0",
    "shortid": "^2.2.16",
    "slate": "^0.120.0",
    "slate-history": "^0.113.1",
    "slate-react": "^0.120.0",
    "styled-components": "^6.1.1"
  },
  "devDependencies": {
    "@testing-library/cypress": "^10.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitejs/plugin-react-refresh": "^1.3.6",
    "babel-plugin-styled-components": "^2.1.4",
    "cypress": "^13.6.6",
    "dotenv": "^16.3.1",
    "eslint": "^8.45.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "firebase-tools": "^13.0.2",
    "prettier": "^3.0.3",
    "react-dev-utils": "^12.0.1",
    "vite": "^4.4.5",
    "vite-plugin-babel-macros": "^1.0.6",
    "vite-plugin-live-reload": "^3.0.2",
    "vitest": "^4.0.18"
  }
}

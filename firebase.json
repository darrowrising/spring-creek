{
    "database": {
        "rules": "database.rules.json"
    },
    "hosting": [{
        "target": "test",
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [{
            "source": "**",
            "destination": "/index.html"
        }]
    },{
        "target": "production",
        "public": "public",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [{
            "source": "**",
            "destination": "/index.html"
        }]
    }],
    "storage": {
        "rules": "storage.rules"
    }
}
